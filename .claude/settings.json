{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/validate-ci.sh"
          }
        ]
      }
    ]
  },
  "agents": {
    "dev-feedback": {
      "path": ".claude/agents/dev-feedback.md",
      "description": "Analyzes feedback on AI-generated code and captures learnings in documentation"
    }
  }
}
